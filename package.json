{
  "name": "simula",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "verify": "npm run check && npm run lint && npm test",
    "publish:check": "vite-node scripts/publish-batch.mjs --check",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler dev",
    "publish": "vite-node scripts/publish-batch.mjs --trigger"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.0"
  }
}
