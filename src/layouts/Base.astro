---
import { loadCatalogEntries } from '../lib/loadCatalog';
import { themeStylesheet } from '../lib/theme';
import Icon from '../components/Icon.astro';
import { navLinksFor } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Set on a page that must never be indexed, such as a raw simulation file. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The footer shows the release and links to the repository. Both are plain
// text here so the footer stays correct even if package.json is not the
// release this site ships as.
const siteVersion = 'v1.1.0';
const repoUrl = 'https://github.com/koosty/simula.koosty.web.id';

// Every page carries the same navigation, so it is built once here rather than
// in each one. The catalog is read again per page rather than cached: Astro
// already holds the content collection for the build, and a cache here would
// only add a path that cannot be exercised by a test.
const catalog = await loadCatalogEntries();
const navLinks = navLinksFor(catalog, Astro.url.pathname);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The palette goes through set:html rather than into the stylesheet below.
        An Astro <style> block is not a template expression site: a {call()} in
        one is not evaluated, it reaches the CSS minifier as literal text and the
        build fails with "Invalid empty selector". Ticket 06 hit this the same
        way, writing {FALLBACK_HEIGHT}px into a <style> block and finding it
        silently dropped rather than caught. */}
    <style set:html={themeStylesheet()}></style>
    {/* Runs before first paint, so a stored choice does not flash the other palette. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
      } catch {
        // Storage can be blocked; the page then stays dark, as the default is.
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <nav class="site-nav" aria-label="Navigasi utama">
      <p class="site-name">
        <a href="/">
          <svg class="brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M2 16H22" />
            <path d="M5 14V18" />
            <path d="M12 14V18" />
            <path d="M5 11.5C5 4 19 4 19 11.5" />
            <circle cx="19" cy="16" r="2.5" stroke="none" style="fill: var(--secondary)" />
          </svg>
          Simula
        </a>
      </p>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.path} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button type="button" id="theme-toggle" class="theme-toggle">
        <span id="theme-icon-light"><Icon name="flashlight" /></span>
        <span id="theme-icon-dark" hidden><Icon name="flashlight-off" /></span>
        <span id="theme-label">Mode terang</span>
      </button>
    </nav>
    <slot />
    <footer class="site-footer">
      <p class="site-footer-version">{siteVersion}</p>
      <p class="site-footer-credit">
        <a href={repoUrl}>Made with <Icon name="heart" class="footer-heart" /><span class="visually-hidden">Love</span> by Papa Caca</a>
      </p>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const label = document.getElementById('theme-label');
      const lightIcon = document.getElementById('theme-icon-light');
      const darkIcon = document.getElementById('theme-icon-dark');
      if (!toggle || !label || !lightIcon || !darkIcon) throw new Error('The theme switch is missing from the header.');
      const currentMode = () => (root.dataset.theme === 'light' ? 'light' : 'dark');
      // The button names the mode it switches to, with the matching flashlight icon.
      const showTarget = (target: 'light' | 'dark') => {
        label.textContent = target === 'light' ? 'Mode terang' : 'Mode gelap';
        lightIcon.hidden = target !== 'light';
        darkIcon.hidden = target !== 'dark';
      };
      showTarget(currentMode() === 'light' ? 'dark' : 'light');
      toggle.addEventListener('click', () => {
        const next = currentMode() === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage can be blocked; the choice then lasts for this page only.
        }
        showTarget(next === 'light' ? 'dark' : 'light');
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    background: var(--bg);
    color: var(--text);
  }

  /* The three families the Stitch screens use: Space Grotesk for headings,
     Plus Jakarta Sans for body text, and JetBrains Mono for labels, numbers and
     the tab bar. They are declared once here. Components name a role, such as
     var(--font-mono), so a missing declaration used to fall back silently to
     the body face. */
  :root {
    --font-display: 'Space Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-body: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
  }

  /* Links take the palette's link colour rather than the browser's default.
     The default is a blue chosen against a white page, and on this background it
     is both the wrong colour and unreadable: it was the one contrast failure
     this site had. Declared once here so a link in a component that styles
     nothing else still reads as a link. */
  a {
    color: var(--link);
  }

  a:hover {
    color: var(--link-hover);
  }

  /* The focus ring, once, for everything on the site.
     A browser's own outline is drawn in a colour chosen for whatever the
     browser thinks the page looks like, which on this background is a grey
     that fails the same 3:1 the rest of the non-text colours have to meet.
     An outline rather than a box-shadow, because an outline does not move the
     layout and so cannot make a control jump as it is focused. */
  :focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  summary:focus-visible,
  iframe:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px 16px;
  }

  /* The arcade bar: a full-width band with the site name on the left and the
     subject tabs on the right. Tabs are uppercase and monospace, like the
     lobby of the Stitch prototype. The current tab is filled with the accent. */
  .site-nav {
    box-sizing: border-box;
    width: 100%;
    padding: 12px max(16px, calc((100% - 1440px) / 2));
    background: var(--surface);
    border-bottom: 2px solid var(--border-strong);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .site-name {
    margin: 0;
    font-weight: 600;
  }

  .site-name a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    text-decoration: none;
    font-size: 1.25rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .brand-mark {
    width: 24px;
    height: 24px;
    flex: none;
  }

  .site-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .site-nav a {
    display: inline-block;
    padding: 8px 14px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--surface);
    border-radius: var(--radius-small);
  }

  .site-nav a:hover {
    color: var(--text);
    border-color: var(--secondary);
  }

  /* The page the reader is on is filled with the accent, so the state is
     visible without relying on colour alone: the text inverts to dark. */
  .site-nav a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    font-weight: 700;
  }

  /* The light and dark switch. It shows the mode it will change to, with a
     flashlight icon: on for light, off for dark. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    min-height: 44px;
    padding: 8px 14px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-small);
    cursor: pointer;
  }

  .theme-toggle .icon {
    width: 1.25em;
    height: 1.25em;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--secondary);
  }

  /* On a phone the tabs stay on one scrolling row, so the header does not
     grow to three or four lines before the page starts. */
  @media (max-width: 760px) {
    .site-nav ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      width: 100%;
      scrollbar-width: none;
    }

    .site-nav a {
      padding: 6px 10px;
      font-size: 0.75rem;
      white-space: nowrap;
    }

    .site-name a {
      font-size: 1.0625rem;
    }
  }

  /* The footer uses the nav's bar style, mirrored to the bottom edge. The
     version sits in a bordered tag, as the Stitch prototype's status tag does,
     and the credit is a link to the repository. Hidden when printed, so a
     printed page carries only its own content, as the navigation does. */
  .site-footer {
    box-sizing: border-box;
    width: 100%;
    padding: 12px max(16px, calc((100% - 1440px) / 2));
    background: var(--surface);
    border-top: 2px solid var(--border-strong);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer-version {
    padding: 4px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-small);
    color: var(--text-muted);
  }

  /* The heart is a solid red shape. Icon draws outlines, so its fill is set
     here; the colour is the palette's error token, not a literal. */
  .footer-heart {
    color: var(--error);
    fill: currentColor;
  }

  /* The word "Love" stays in the text for screen readers while the heart is
     shown in its place. The standard clip pattern hides it on screen. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media print {
    .site-footer {
      display: none;
    }
  }

  /* One card style for every grid of simulations, so a card looks the same on
     the home page, in the catalogue and on a class page. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .card {
    position: relative;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s, transform 0.2s;
  }

  .card:hover {
    border-color: var(--accent);
  }

  /* The lit marquee bar along the top edge of a panel. The glow is on this
     decorative bar only, never on text. */
  .card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }


  .card h3 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .card a {
    color: var(--link);
    text-decoration: none;
  }

  .card a:hover,
  .card a:focus-visible {
    color: var(--text);
    text-decoration: underline;
  }

  .card-meta {
    margin: 0 0 8px;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .card-description {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
</style>
