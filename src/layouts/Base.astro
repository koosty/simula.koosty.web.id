---
import { loadCatalogEntries } from '../lib/loadCatalog';
import { themeCustomProperties } from '../lib/theme';
import { navLinksFor } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Set on a page that must never be indexed, such as a raw simulation file. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Every page carries the same navigation, so it is built once here rather than
// in each one. The catalog is read again per page rather than cached: Astro
// already holds the content collection for the build, and a cache here would
// only add a path that cannot be exercised by a test.
const catalog = await loadCatalogEntries();
const navLinks = navLinksFor(catalog, Astro.url.pathname);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The palette goes through set:html rather than into the stylesheet below.
        An Astro <style> block is not a template expression site: a {call()} in
        one is not evaluated, it reaches the CSS minifier as literal text and the
        build fails with "Invalid empty selector". Ticket 06 hit this the same
        way, writing {FALLBACK_HEIGHT}px into a <style> block and finding it
        silently dropped rather than caught. */}
    <style set:html={themeCustomProperties()}></style>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <nav class="site-nav" aria-label="Navigasi utama">
      <p class="site-name"><a href="/">Simula</a></p>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.path} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  html {
    background: var(--bg);
    color: var(--text);
  }

  body {
    margin: 0;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-family: 'Space Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* Links take the palette's link colour rather than the browser's default.
     The default is a blue chosen against a white page, and on this background it
     is both the wrong colour and unreadable: it was the one contrast failure
     this site had. Declared once here so a link in a component that styles
     nothing else still reads as a link. */
  a {
    color: var(--link);
  }

  a:hover {
    color: var(--link-hover);
  }

  /* The focus ring, once, for everything on the site.
     A browser's own outline is drawn in a colour chosen for whatever the
     browser thinks the page looks like, which on this background is a grey
     that fails the same 3:1 the rest of the non-text colours have to meet.
     An outline rather than a box-shadow, because an outline does not move the
     layout and so cannot make a control jump as it is focused. */
  :focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  summary:focus-visible,
  iframe:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 16px;
  }

  .site-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
    border-bottom: 1px solid var(--border);
  }

  .site-name {
    margin: 0 0 8px;
    font-weight: 600;
  }

  .site-name a {
    color: var(--text);
    text-decoration: none;
    font-size: 1.125rem;
  }

  .site-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .site-nav a {
    color: var(--link);
  }

  /* The page the reader is on is marked rather than dimmed alone, so the state
     is available to a screen reader as well as visible. */
  .site-nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
</style>
