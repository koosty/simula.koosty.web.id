---
import { loadCatalogEntries } from '../lib/loadCatalog';
import { themeCustomProperties } from '../lib/theme';
import { navLinksFor } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Set on a page that must never be indexed, such as a raw simulation file. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Every page carries the same navigation, so it is built once here rather than
// in each one. The catalog is read again per page rather than cached: Astro
// already holds the content collection for the build, and a cache here would
// only add a path that cannot be exercised by a test.
const catalog = await loadCatalogEntries();
const navLinks = navLinksFor(catalog, Astro.url.pathname);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The palette goes through set:html rather than into the stylesheet below.
        An Astro <style> block is not a template expression site: a {call()} in
        one is not evaluated, it reaches the CSS minifier as literal text and the
        build fails with "Invalid empty selector". Ticket 06 hit this the same
        way, writing {FALLBACK_HEIGHT}px into a <style> block and finding it
        silently dropped rather than caught. */}
    <style set:html={themeCustomProperties()}></style>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <nav class="site-nav" aria-label="Navigasi utama">
      <p class="site-name">
        <a href="/">
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M8 15 L12 8 L16 15" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          Simula
        </a>
      </p>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.path} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  html {
    background: var(--bg);
    color: var(--text);
  }

  body {
    margin: 0;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-family: 'Space Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* Links take the palette's link colour rather than the browser's default.
     The default is a blue chosen against a white page, and on this background it
     is both the wrong colour and unreadable: it was the one contrast failure
     this site had. Declared once here so a link in a component that styles
     nothing else still reads as a link. */
  a {
    color: var(--link);
  }

  a:hover {
    color: var(--link-hover);
  }

  /* The focus ring, once, for everything on the site.
     A browser's own outline is drawn in a colour chosen for whatever the
     browser thinks the page looks like, which on this background is a grey
     that fails the same 3:1 the rest of the non-text colours have to meet.
     An outline rather than a box-shadow, because an outline does not move the
     layout and so cannot make a control jump as it is focused. */
  :focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  summary:focus-visible,
  iframe:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 16px;
  }

  /* The arcade bar: a full-width band with the site name on the left and the
     subject tabs on the right. Tabs are uppercase and monospace, like the
     lobby of the Stitch prototype. The current tab is filled with the accent. */
  .site-nav {
    box-sizing: border-box;
    width: 100%;
    padding: 12px max(16px, calc((100% - 1200px) / 2));
    background: var(--surface);
    border-bottom: 2px solid var(--border-strong);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .site-name {
    margin: 0;
    font-weight: 600;
  }

  .site-name a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    text-decoration: none;
    font-size: 1.25rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .brand-mark {
    width: 24px;
    height: 24px;
    flex: none;
  }

  .site-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .site-nav a {
    display: inline-block;
    padding: 8px 14px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--surface);
    border-radius: var(--radius-small);
  }

  .site-nav a:hover {
    color: var(--text);
    border-color: var(--secondary);
  }

  /* The page the reader is on is filled with the accent, so the state is
     visible without relying on colour alone: the text inverts to dark. */
  .site-nav a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    font-weight: 700;
  }

  /* On a phone the tabs stay on one scrolling row, so the header does not
     grow to three or four lines before the page starts. */
  @media (max-width: 760px) {
    .site-nav ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      width: 100%;
      scrollbar-width: none;
    }

    .site-nav a {
      padding: 6px 10px;
      font-size: 0.75rem;
      white-space: nowrap;
    }

    .site-name a {
      font-size: 1.0625rem;
    }
  }

  /* One card style for every grid of simulations, so a card looks the same on
     the home page, in the catalogue and on a class page. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .card {
    position: relative;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  /* The lit marquee bar along the top edge of a panel. */
  .card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--accent);
  }

  .card h3 {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .card a {
    color: var(--link);
    text-decoration: none;
  }

  .card a:hover,
  .card a:focus-visible {
    color: var(--text);
    text-decoration: underline;
  }

  .card-meta {
    margin: 0 0 8px;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .card-description {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
</style>
