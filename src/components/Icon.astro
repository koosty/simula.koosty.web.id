---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.125em;
  }
</style>
