---
import Base from '../layouts/Base.astro';
import { simulasiUrl } from '../lib/catalog';
import { sheetPath } from '../lib/sheet';
import { landingDescription, landingHeading, landingTitle, type LandingPage } from '../lib/landing';
import { subjectLabel } from '../lib/katalogFilter';
import { tingkatLabel } from '../lib/tingkat';

interface Props {
  page: LandingPage;
  /** Every landing page at the same stage, this one included. */
  siblings: LandingPage[];
}

const { page, siblings } = Astro.props;

const kelasSiblings = siblings.filter((sibling) => sibling.kind === 'kelas');
const subjectSiblings = siblings.filter((sibling) => sibling.kind === 'mataPelajaran');

// A stage, a class and a subject are three different things to look for, so the
// links beside this page are grouped by what they lead to rather than listed as
// one run the reader has to sort out.
const stagePath = `/${page.level}/`;

// The address of this class's printable sheet, built by the same module the
// sheet route uses. Concatenating a segment onto the page path here would leave
// one callsite that a renamed segment silently breaks.
const sheetHref = page.kind === 'kelas' ? sheetPath(page.level, page.segment) : null;
---

<Base title={landingTitle(page)} description={landingDescription(page)}>
  <main class="wrap">
    <nav class="breadcrumb" aria-label="Lokasi">
      <a href="/">Beranda</a> <span aria-hidden="true">/</span>
      <a href="/katalog/">Katalog</a> <span aria-hidden="true">/</span>
      {
        page.kind === 'tingkat' ? (
          <span aria-current="page">{landingHeading(page)}</span>
        ) : (
          <>
            <a href={stagePath}>{tingkatLabel(page.level)}</a>{' '}
            <span aria-hidden="true">/</span> <span aria-current="page">{landingHeading(page)}</span>
          </>
        )
      }
    </nav>

    <h1>{landingHeading(page)}</h1>
    {
      /* Only a class has a sheet. A stage or a subject page has no one term's
         list to print, so it offers nothing here. */
      sheetHref && (
        <p class="sheet-link">
          <a href={sheetHref}>Daftar cetak — satu daftar per semester, untuk dikerjakan bersama di kelas</a>
        </p>
      )
    }
    <p class="lead">{landingDescription(page)}</p>

    {
      page.sections.map((section) => {
        // A class page's only section is already named by the h1, so it gets no
        // subheading. Every other page groups its cards under the class they
        // belong to, and that heading is what the cards sit below.
        const hasSectionHeading = page.kind !== 'kelas';
        // The card heading must be one level below whatever precedes it, or a
        // screen reader announces a jump from h1 straight to h3.
        const CardHeading = hasSectionHeading ? 'h3' : 'h2';
        const SectionHeading = hasSectionHeading ? 'h2' : null;
        return (
          <section class="kelas" id={section.key}>
            {SectionHeading && <SectionHeading>{section.label}</SectionHeading>}
            <ul class="cards">
              {section.simulations.map((entry) => (
                <li class="card">
                  <CardHeading>
                    <a href={simulasiUrl(entry)}>{entry.title}</a>
                  </CardHeading>
                  <p class="card-description">{entry.description}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    {
      (page.kind === 'tingkat' || kelasSiblings.length > 0) && (
        <nav class="siblings" aria-labelledby="sibling-kelas">
          <h2 id="sibling-kelas">
            {page.kind === 'tingkat'
              ? `Kelas di ${tingkatLabel(page.level)}`
              : `Kelas lain di ${tingkatLabel(page.level)}`}
          </h2>
          <ul>
            {/* A class page links up to its stage as well as sideways, since the
                stage is where a reader goes to find every class at once. */}
            {page.kind === 'tingkat' ? null : (
              <li>
                <a href={stagePath}>Semua kelas di {tingkatLabel(page.level)}</a>
              </li>
            )}
            {kelasSiblings.map((sibling) => (
              <li>
                <a href={sibling.path}>{sibling.sections[0]?.label ?? sibling.segment}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      subjectSiblings.length > 0 && (
        <nav class="siblings" aria-labelledby="sibling-mapel">
          <h2 id="sibling-mapel">Mata pelajaran di {tingkatLabel(page.level)}</h2>
          <ul>
            {subjectSiblings.map((sibling) => (
              <li>
                <a href={sibling.path}>{subjectLabel(sibling.segment)}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </main>
</Base>

<style>
  .breadcrumb {
    margin-bottom: 16px;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .breadcrumb a {
    color: var(--link);
  }

  h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin-top: 0;
  }

  .sheet-link {
    margin: 0 0 16px;
  }

  .sheet-link a {
    color: var(--link);
  }

  .kelas {
    margin-top: 32px;
  }


  .siblings {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .siblings h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .siblings ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .siblings a {
    color: var(--link);
  }
</style>
