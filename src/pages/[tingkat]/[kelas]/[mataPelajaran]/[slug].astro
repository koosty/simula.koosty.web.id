---
import type { GetStaticPaths } from 'astro';
import Base from '../../../../layouts/Base.astro';
import { simulasiFileUrl, simulasiUrlSegments } from '../../../../lib/catalog';
import { tingkatLabel } from '../../../../lib/tingkat';
import { loadCatalog } from '../../../../lib/loadCatalog';

// The route params and the full URL are both composed by simulasiUrlSegments,
// so the page and the catalog can never disagree about where a simulation
// lives (docs/adr/0003).
export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();

  return catalog.map((entry) => ({
    params: simulasiUrlSegments(entry),
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
// The iframe points at the level the simulation file actually lives under, not
// the level the catalog entry claims, so a level disagreement can never turn
// into a dead link.
const rawFileUrl = simulasiFileUrl(entry, entry.fileLevel);
---

<Base title={`${entry.title} · Simula`} description={entry.description}>
  <main class="wrap">
    <article>
      <header>
        <h1>{entry.title}</h1>
        <p class="description">{entry.description}</p>
        <p class="meta">
          {tingkatLabel(entry.level)} · Kelas {entry.grade}
        </p>
      </header>

      <iframe src={rawFileUrl} title={entry.title} loading="lazy"></iframe>

      <p class="fallback">
        <a href={rawFileUrl}>Buka simulasi ini di tab baru</a> jika simulasi tidak
        muncul di atas.
      </p>
    </article>
  </main>
</Base>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .description {
    font-size: 1.0625rem;
    color: #c8c8c8;
    max-width: 65ch;
    margin: 0 0 8px;
  }

  .meta {
    color: #9a9a9a;
    font-size: 0.875rem;
    margin: 0 0 32px;
  }

  iframe {
    display: block;
    width: 100%;
    /* A fixed fallback height. Measuring the simulation's real height, and
       letting the frame grow to it, is the next ticket's work
       (docs/adr/0005). */
    height: 80vh;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #0a0a1a;
  }

  .fallback {
    margin-top: 16px;
    font-size: 0.9375rem;
    color: #9a9a9a;
  }
</style>
