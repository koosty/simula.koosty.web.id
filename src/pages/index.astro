---
import Base from '../layouts/Base.astro';
import { simulasiFileUrl, simulasiUrl } from '../lib/catalog';
import { loadCatalog } from '../lib/loadCatalog';
import { subjectLabel } from '../lib/katalogFilter';
import { homeClassSections, homeFeatured, homeStages } from '../lib/home';

// The Katalog is the whole catalog, always. The home page is an entrance into
// it, so it reads the same data rather than a filtered copy that could disagree.
// loadCatalog rather than loadCatalogEntries: the opening simulation is framed
// from the folder its file lives in, which only loadCatalog knows.
const catalog = await loadCatalog();

const featured = homeFeatured(catalog);
const classes = homeClassSections(catalog);
const stages = homeStages(catalog);
const total = catalog.length;
// Every figure in the stat cards is counted from the catalogue. The Stitch
// prototype shows made-up numbers for credits and streaks; the site has no
// accounts or scores, so those are left out rather than invented.
const subjects = new Set(catalog.map((entry) => entry.subject)).size;
---

<Base
  title="Simula — Katalog Simulasi Pembelajaran"
  description="Katalog simulasi pembelajaran interaktif untuk murid dan guru, disusun per tingkat dan kelas."
>
  <main class="wrap home">
    <section class="bench" aria-labelledby="home-heading">
      <div class="intro">
        <p class="eyebrow">Katalog simulasi</p>
        <h1 id="home-heading">Pilih simulasi dan mulai belajar</h1>

        <p class="lead">
          Simula menyimpan simulasi pembelajaran yang bisa langsung dibuka di peramban.
          Murid mengubah angka atau menggerakkan titik, lalu langsung melihat hasilnya,
          tanpa memasang aplikasi apa pun.
        </p>

        <a class="insert-coin" href="/katalog/">Mulai belajar</a>

        <ul class="stats" aria-label="Isi katalog">
          <li class="stat">
            <span class="stat-label">Simulasi</span>
            <span class="stat-value">{total}</span>
          </li>
          <li class="stat">
            <span class="stat-label">Kelas</span>
            <span class="stat-value">{classes.length}</span>
          </li>
          <li class="stat">
            <span class="stat-label">Mata pelajaran</span>
            <span class="stat-value">{subjects}</span>
          </li>
        </ul>

        {
          total === 0 ? (
            <p class="status">
              Katalog ini sedang disiapkan. Belum ada simulasi yang dipublikasikan;
              simulasinya akan segera hadir.
            </p>
          ) : (
            <p class="status">
              Saat ini ada <strong>{total} simulasi</strong>, disusun sesuai urutan materi
              setiap kelas.
            </p>
          )
        }

        {
          featured && (
            <section class="featured" aria-labelledby="featured-heading">
              <h2 id="featured-heading">Mulai di sini</h2>
              <p class="featured-title">
                <a href={simulasiUrl(featured)}>{featured.title}</a>
              </p>
              <p class="meta">
                Kelas {featured.grade} · {subjectLabel(featured.subject)}
              </p>
              <p class="description">{featured.description}</p>
            </section>
          )
        }
      </div>

      {
        featured && (
          <div class="bench-frame">
            <iframe
              src={simulasiFileUrl(featured, featured.fileLevel)}
              title={featured.title}
            ></iframe>
            <p class="fallback">
              <a
                href={simulasiFileUrl(featured, featured.fileLevel)}
                target="_blank"
                rel="noopener"
              >Buka simulasi ini di tab baru</a>
              {' '}jika simulasi tidak muncul di atas.
            </p>
          </div>
        )
      }
    </section>

    {
      stages.length > 0 && (
        <nav class="stages" aria-labelledby="stages-heading">
          <h2 id="stages-heading">Telusuri per tingkat</h2>
          <ul class="stage-list">
            {stages.map((stage) => (
              <li>
                <a href={stage.path}>{stage.label}</a>
                <span class="stage-count">{stage.count} simulasi</span>
              </li>
            ))}
          </ul>
          <p class="stage-more">
            <a href="/katalog/">Lihat seluruh simulasi di Katalog</a>, atau saring
            menurut tingkat, kelas, dan mata pelajaran.
          </p>
        </nav>
      )
    }

    {
      classes.map((section) => (
        <section class="band" aria-labelledby={`kelas-${section.key.replace('/', '-')}`}>
          <h2 id={`kelas-${section.key.replace('/', '-')}`}>{section.label}</h2>
          <ul class="cards">
            {section.simulations.map((entry) => (
              <li class="card">
                <h3>
                  <a href={simulasiUrl(entry)}>{entry.title}</a>
                </h3>
                <p class="card-meta">{subjectLabel(entry.subject)}</p>
                <p class="card-description">{entry.description}</p>
              </li>
            ))}
          </ul>
          <p class="band-more">
            <a href={section.path}>Lihat {section.total} simulasi di {section.label}</a>
          </p>
        </section>
      ))
    }

    {
      total === 0 && (
        <p class="katalog-link">
          <a href="/katalog/">Lihat seluruh simulasi di Katalog</a>.
        </p>
      )
    }
  </main>
</Base>

<style>
  /* The opening screen: the heading and the stat cards on the left, the working
     simulation on the right, in a framed panel. Stacked below 760px so the frame
     keeps the full width of a phone. */
  .bench {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding-top: 16px;
  }

  @media (max-width: 760px) {
    .bench {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 16px;
    padding: 4px 10px;
    border: 1px solid var(--secondary);
    border-radius: var(--radius-small);
    color: var(--secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 4px;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 4px;
  }

  .lead {
    font-size: 1.0625rem;
    color: var(--text-muted);
    margin: 0 0 24px;
  }

  /* The main call to action, styled as the arcade's coin button. */
  .insert-coin {
    display: inline-block;
    padding: 12px 22px;
    background: var(--accent);
    color: var(--bg);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 0 16px rgba(0, 240, 255, 0.35);
  }

  .insert-coin:hover {
    color: var(--bg);
    background: var(--link-hover);
  }

  .stats {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat {
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-label {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stat-value {
    color: var(--tertiary);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .status {
    margin: 24px 0 32px;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }

  .featured {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .featured h2 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin: 0 0 8px;
  }

  .featured-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 4px;
  }

  .featured-title a {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .meta {
    margin: 0 0 8px;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  /* The frame is the simulation's own panel. Its border is the strong outline
     colour and it has a lit top edge, as the Stitch workspace does. The height
     is fixed to the first screen (ADR 0005); the open link gives the full page. */
  .bench-frame iframe {
    display: block;
    width: 100%;
    box-sizing: border-box;
    height: clamp(420px, 70vh, 680px);
    border: 1px solid var(--border-strong);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg);
    color-scheme: dark;
  }

  iframe:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .fallback {
    margin: 12px 0 0;
    font-size: 0.9375rem;
    color: var(--text-dim);
  }

  .fallback a,
  .stage-list a,
  .stage-more a,
  .band-more a,
  .katalog-link a,
  .card h3 a,
  .featured-title a {
    color: var(--link);
  }

  .stages,
  .band {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .stage-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    list-style: none;
    margin: 12px 0 16px;
    padding: 0;
  }

  .stage-list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .stage-count {
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .stage-more,
  .band-more {
    margin: 12px 0 0;
    color: var(--text-dim);
    font-size: 0.9375rem;
  }

  .katalog-link {
    margin-top: 32px;
    font-size: 1rem;
  }

  @media (max-width: 760px) {
    h1 {
      font-size: 2rem;
    }
  }
</style>
