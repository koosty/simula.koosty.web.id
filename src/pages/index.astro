---
import Base from '../layouts/Base.astro';
import { loadCatalog } from '../lib/loadCatalog';

const catalog = await loadCatalog();
---

<Base
  title="Simula — Katalog Simulasi Pembelajaran"
  description="Katalog simulasi pembelajaran interaktif untuk murid dan guru, disusun per tingkat dan kelas."
>
  <main class="wrap">
    <h1>Simula</h1>

    <p class="lead">
      Katalog simulasi pembelajaran interaktif untuk murid dan guru. Setiap simulasi
      dapat langsung dibuka di peramban tanpa memasang aplikasi apa pun.
    </p>

    {
      catalog.length === 0 ? (
        <p class="status">
          Katalog ini sedang disiapkan. Belum ada simulasi yang dipublikasikan;
          simulasinya akan segera hadir.
        </p>
      ) : (
        <p class="status">
          {catalog.length} simulasi sudah tersedia, disusun per tingkat dan kelas.
        </p>
      )
    }

    <p class="katalog-link">
      <a href="/katalog/">Lihat seluruh simulasi di Katalog</a>, atau saring
      menurut tingkat, kelas, dan mata pelajaran.
    </p>
  </main>
</Base>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .lead {
    font-size: 1.125rem;
    color: #c8c8c8;
    max-width: 60ch;
  }

  .status {
    margin-top: 32px;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #1b1b1b;
  }

  .katalog-link {
    margin-top: 24px;
    font-size: 1rem;
  }

  .katalog-link a {
    color: #cfe3ff;
  }
</style>