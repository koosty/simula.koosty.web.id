---
import Base from '../layouts/Base.astro';
---

<Base
  title="Simula — Katalog Simulasi Pembelajaran"
  description="Katalog simulasi pembelajaran interaktif untuk murid dan guru, disusun per tingkat dan kelas."
>
  <main class="wrap">
    <h1>Simula</h1>

    <p class="lead">
      Katalog simulasi pembelajaran interaktif untuk murid dan guru. Setiap simulasi
      dapat langsung dibuka di peramban tanpa memasang aplikasi apa pun.
    </p>

    <p class="status">
      Katalog ini sedang disiapkan. Belum ada simulasi yang dipublikasikan; simulasinya
      akan segera hadir.
    </p>
  </main>
</Base>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 16px;
  }

  .lead {
    font-size: 1.125rem;
    color: #c8c8c8;
    max-width: 60ch;
  }

  .status {
    margin-top: 32px;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #1b1b1b;
  }
</style>