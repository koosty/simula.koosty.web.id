---
import Base from '../layouts/Base.astro';
import { simulasiUrl } from '../lib/catalog';
import { loadCatalogEntries } from '../lib/loadCatalog';
import { buildFilterFields, groupByKelas, subjectLabel } from '../lib/katalogFilter';
import { landingHeading, landingPages } from '../lib/landing';
import { tingkatLabel } from '../lib/tingkat';
import type { CatalogEntry } from '../lib/types';

// The Katalog is the whole catalog, always. Every simulation is in the HTML in
// display order, and the script below only hides what is already there, which is
// what lets the page work with scripting unavailable. Display order is applied
// by groupByKelas below, which owns it; sorting here as well would be a second
// pass over the same data that could disagree with it.
const catalog = await loadCatalogEntries();

const filterFields = buildFilterFields(catalog);

// Tingkat is a row of chips rather than a dropdown, so it is taken out of the
// dropdown fields. The chips list every Tingkat in the catalog, in school order.
const levelChoices = filterFields.find((field) => field.field === 'level')?.choices ?? [];
const dropdownFields = filterFields.filter((field) => field.field !== 'level');

// The filter hides and shows cards by these attributes, so the catalog travels
// with the page and filtering needs no fetch and no framework runtime. The
// title and description are not copied in: the script reads them back out of
// the card text, so there is one copy of each rather than two that could drift.
const cardAttributes = (entry: CatalogEntry) => ({
  'data-slug': entry.slug,
  'data-level': entry.level,
  // Spesialisasi has no class, so it carries no grade (docs/adr/0027).
  'data-grade': entry.grade === undefined ? undefined : String(entry.grade),
  'data-subject': entry.subject,
});

const groups = groupByKelas(catalog);

// The filters narrow the list in place, which answers "which of these match"
// but not "show me everything for this class". The landing pages below are that
// other half, at addresses a teacher can bookmark. They are built from the same
// catalog the filters read, so a link cannot point at a page that does not exist.
const landing = landingPages(catalog);
---

<Base
  title="Katalog Simulasi · Simula"
  description="Daftar seluruh simulasi pembelajaran di Simula, dapat disaring menurut tingkat, kelas, dan mata pelajaran."
>
  <main class="wrap">
    <div class="kicker">
      <span class="kicker-dot" aria-hidden="true"></span>
      <span>Katalog simulasi arcade</span>
    </div>
    <h1>Kabinet sains utama</h1>
    <p class="lead">
      Seluruh simulasi di Simula, disusun dalam urutan materi. Pilih tingkat,
      lalu saring kelas atau mata pelajaran, atau ketik sebagian judul untuk mencari.
    </p>

    <!-- Filtering is done by the script below, so this form is never submitted. -->
    <form class="filters" id="filters">
      <p class="filters-heading">Tingkat</p>
      <div class="chips" role="group" aria-label="Tingkat">
        <button type="button" class="chip" data-level="" aria-pressed="true">Semua</button>
        {
          levelChoices.map((choice) => (
            <button type="button" class="chip" data-level={String(choice.value)} aria-pressed="false">
              {choice.label}
            </button>
          ))
        }
      </div>

      <div class="filters-row">
        {
          dropdownFields.map((field) => (
            <p class="filter">
              <label for={`filter-${field.field}`}>{field.label}</label>
              <select id={`filter-${field.field}`} name={field.field} data-filter={field.field}>
                <option value="">Semua</option>
                {field.choices.map((choice) => (
                  <option value={String(choice.value)}>{choice.label}</option>
                ))}
              </select>
            </p>
          ))
        }

        <p class="filter">
          <label for="search">Cari simulasi</label>
          <input id="search" name="search" type="search" placeholder="misal: segitiga" />
        </p>
      </div>

      <p class="result-count" id="result-count" role="status"></p>
    </form>

    {
      catalog.length === 0 ? (
        <p class="empty">
          Katalog ini sedang disiapkan. Belum ada simulasi yang dipublikasikan;
          simulasinya akan segera hadir.
        </p>
      ) : (
        <div id="results">
          {groups.map((group) => (
            <section class="kelas">
              <h2>{group.label}</h2>
              <ul class="cards">
                {group.simulations.map((entry) => (
                  <li class="card" {...cardAttributes(entry)}>
                    <p class="card-tag">{subjectLabel(entry.subject)}</p>
                    <h3>
                      <a href={simulasiUrl(entry)}>{entry.title}</a>
                    </h3>
                    <p class="card-meta">
                      {tingkatLabel(entry.level)} · Kelas {entry.grade}
                    </p>
                    <p class="card-description">{entry.description}</p>
                    <a class="card-stretch" href={simulasiUrl(entry)} aria-hidden="true" tabindex="-1"></a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }

    <!-- Outside the filtered region, because these are pages rather than
         results: narrowing the list must not hide the way into them. -->
    {
      landing.length > 0 && (
        <nav class="landing" aria-labelledby="landing-heading">
          <h2 id="landing-heading">Telusuri per kelas dan mata pelajaran</h2>
          <p class="landing-lead">
            Alamat halaman ini tidak berubah, jadi bisa disimpan untuk kembali lagi.
          </p>
          {landing.map((page) => (
            <ul class="landing-list">
              <li>
                <a href={page.path}>{landingHeading(page)}</a>
              </li>
            </ul>
          ))}
        </nav>
      )
    }

    <p class="no-match" id="no-match" hidden>
      Tidak ada simulasi yang cocok. Coba kata lain, atau kosongkan saringan.
    </p>
  </main>
</Base>

<script>
  import { filterCatalog, searchCatalog } from '../lib/katalogFilter';
  import type { CatalogEntry } from '../lib/types';

  // Filtering runs in the browser over markup that is already in the page.
  // Nothing here is required to read the Katalog: without it the full list stays
  // visible, and the controls are hidden by the noscript style below.
  const results = document.getElementById('results');
  const noMatch = document.getElementById('no-match');
  const count = document.getElementById('result-count');
  const controls = document.getElementById('filters');

  if (results && noMatch && count && controls) {
    // The catalog is read back off the rendered cards, so there is one list of
    // simulations rather than two that could disagree.
    const cardList = [...results.querySelectorAll<HTMLElement>('.card')];
    const catalog: CatalogEntry[] = cardList.map((card) => ({
      slug: card.dataset.slug ?? '',
      title: card.querySelector('h3 a')?.textContent ?? '',
      description: card.querySelector('.card-description')?.textContent ?? '',
      level: card.dataset.level ?? '',
      grade: card.dataset.grade === undefined ? undefined : Number(card.dataset.grade),
      subject: card.dataset.subject ?? '',
      order: 0,
    }));

    const selects = [...controls.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const chips = [...controls.querySelectorAll<HTMLButtonElement>('.chip')];
    const searchBox = controls.querySelector<HTMLInputElement>('#search');

    const apply = () => {
      const selection: { level?: string; grade?: number; subject?: string } = {};
      const activeChip = chips.find((chip) => chip.getAttribute('aria-pressed') === 'true');
      if (activeChip?.dataset.level) selection.level = activeChip.dataset.level;
      for (const select of selects) {
        if (select.value === '') continue;
        if (select.dataset.filter === 'grade') selection.grade = Number(select.value);
        else if (select.dataset.filter === 'subject') selection.subject = select.value;
      }

      const term = searchBox?.value ?? '';
      const matches = new Set(
        searchCatalog(filterCatalog(catalog, selection), term).map((entry) => entry.slug),
      );

      let visible = 0;
      for (const [index, card] of cardList.entries()) {
        const show = matches.has(catalog[index].slug);
        card.hidden = !show;
        if (show) visible += 1;
      }

      // A class whose simulations are all filtered out must not keep its heading.
      for (const section of results.querySelectorAll<HTMLElement>('.kelas')) {
        section.hidden = ![...section.querySelectorAll<HTMLElement>('.card')].some(
          (card) => !card.hidden,
        );
      }

      count.textContent =
        visible === catalog.length ? `${visible} simulasi` : `${visible} dari ${catalog.length} simulasi`;
      noMatch.hidden = visible !== 0;
    };

    for (const select of selects) select.addEventListener('change', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
        apply();
      });
    }

    // Pressing Enter in the search box would otherwise submit this form and
    // reload the page, discarding the search term and every chosen filter.
    controls.addEventListener('submit', (event) => event.preventDefault());
    searchBox?.addEventListener('input', apply);
    apply();
  }
</script>

<noscript>
  <style>
    /* Without scripting the filters cannot work, so they are removed rather
       than left on screen as controls that do nothing. */
    #filters {
      display: none;
    }
  </style>
</noscript>

<style>
  h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--secondary);
  }

  .lead {
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 65ch;
    margin: 0 0 24px;
  }

  .filters {
    padding: 16px;
    margin-bottom: 32px;
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .filters-heading {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .chip {
    min-height: 44px;
    padding: 8px 16px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .chip:hover {
    color: var(--text);
  }

  .chip[aria-pressed='true'] {
    color: var(--accent-text);
    background: var(--accent);
    border-color: var(--accent);
  }

  .chip:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .filters-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: end;
  }

  .filter {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }

  .filter label {
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .filter select,
  .filter input {
    min-height: 44px;
    padding: 6px 10px;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
  }

  .result-count {
    margin: 0 0 0 auto;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .kelas {
    margin-bottom: 40px;
  }

  .kelas h2 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 16px;
    padding-left: 12px;
    border-left: 4px solid var(--secondary);
  }

  .card-tag {
    display: inline-block;
    margin: 0 0 12px;
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--secondary);
    border: 1px solid var(--secondary);
    border-radius: var(--radius);
  }

  .card-stretch {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .card h3 a {
    position: relative;
    z-index: 1;
  }

  .empty,
  .no-match {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .landing {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .landing h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .landing-lead {
    color: var(--text-muted);
    margin: 0 0 16px;
  }

  .landing-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .landing-list a {
    color: var(--link);
  }
</style>
